<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Palkia.Infra</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Palkia.Core\Palkia.Core.csproj" />
    <!-- DbAiKeyStore persists admin-managed gateway keys through EF. -->
    <ProjectReference Include="..\Palkia.Data\Palkia.Data.csproj" />
  </ItemGroup>

  <!-- ApiKeyAuthenticator / AiRequestRouter speak HttpRequest/HttpContext;
       FrameworkReference (not a NuGet package) - provided by the web host's
       shared framework at run time on Palkia. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
