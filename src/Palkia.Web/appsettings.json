{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": "Data Source=/var/lib/palkia/palkia.db"
  },
  "OpenRc": {
    "WrapperPath": "/usr/local/sbin/palkia-rc-ctl",
    "SudoPath": "/usr/bin/sudo"
  },
  "Auth": {
    "IdleTimeoutMinutes": 60
  },
  "ResourceBroker": {
    "_comment": "Deliberately less than the full 4 cores / 16GB / 12GB VRAM - headroom stays reserved for the OS, this app, and always-on Samba/NFS.",
    "CpuCores": 3,
    "MemoryMb": 12288,
    "VramMb": 11000
  },
  "Minecraft": {
    "CpuCores": 2,
    "MemoryMb": 6144
  },
  "MinecraftConsole": {
    "LogPath": "/var/log/minecraft/minecraft.log",
    "ConsoleFifoPath": "/var/lib/minecraft/console.fifo",
    "CommandWriteTimeoutSeconds": 3
  },
  "AdminSeed": {
    "_comment": "Set Username/Password via environment variables (AdminSeed__Username, AdminSeed__Password) or dotnet user-secrets in dev - never commit real values here.",
    "Username": "",
    "Password": "",
    "DisplayName": ""
  }
}
